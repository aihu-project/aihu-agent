{
  "name": "aihu-agent-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.8",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run build && npm run --workspaces --if-present test",
    "release:contract": "node scripts/release-contract.mjs",
    "verify": "npm run typecheck && npm run test && npm run build && npm run release:contract"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "rolldown": "^1.0.0-rc.17",
    "rolldown-plugin-dts": "^0.23.2",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
