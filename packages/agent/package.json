{
  "name": "@aihu/agent",
  "version": "0.2.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rolldown -c",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:check": "bun run --cwd ../.. release:contract --package=packages/agent",
    "test:release-contract": "bun run --cwd ../.. release:contract --package=packages/agent",
    "prepublishOnly": "bun run build"
  },
  "description": "Agent primitives — the foundation of aihu agent-readiness.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu-agent.git"
  },
  "homepage": "https://github.com/aihu-project/aihu-agent#readme",
  "bugs": "https://github.com/aihu-project/aihu-agent/issues",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "bun@1.3.8",
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "rolldown": "^1.0.0-rc.17",
    "rolldown-plugin-dts": "^0.23.2",
    "typescript": "^5.6.2",
    "vitest": "^3.2.6"
  }
}
