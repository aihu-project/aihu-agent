  "repository": {
    "type": "git",
    "url": "git+https://github.com/aihu-project/aihu-agent.git",
    "directory": "packages/agent-acp"
  },
  "homepage": "https://github.com/aihu-project/aihu-agent/tree/main/packages/agent-acp#readme",
  "bugs": "https://github.com/aihu-project/aihu-agent/issues",
